<Project>

  <PropertyGroup>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <!-- Temporary for GT Motive deadline: skip IDE code-style diagnostics during build. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
  </PropertyGroup>

  <ItemGroup>
    <!-- StyleCop.Analyzers temporarily disabled; restore after delivery if desired. -->
    <PackageReference Include="SonarAnalyzer.CSharp" />
  </ItemGroup>

</Project>