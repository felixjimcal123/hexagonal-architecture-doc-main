<Project>

  <PropertyGroup>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <!-- Enforce IDE code-style diagnostics alongside quality analyzers. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
  </PropertyGroup>

  <ItemGroup>
    <!-- StyleCop.Analyzers temporarily disabled; restore after delivery if desired. -->
    <PackageReference Include="SonarAnalyzer.CSharp" />
  </ItemGroup>

</Project>